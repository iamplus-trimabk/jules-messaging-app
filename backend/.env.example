# .env.example

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=simflo

# WARNING: Do not use DB_SYNCHRONIZE=true in production. Use migrations instead.
DB_SYNCHRONIZE=true

# Application Port
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRATION_TIME=2592000
